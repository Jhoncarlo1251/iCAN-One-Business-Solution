# PRODUCTION TEMPLATE ONLY — copy to .env on your server and replace every placeholder.
# Never commit/share the completed file. Prefer your host's secret manager when available.
NODE_ENV=production
PORT=4000
POSTGRES_DB=ican_db
POSTGRES_USER=ican_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
# DATABASE_URL can be your own PostgreSQL URL OR Supabase PostgreSQL pooler URL.
DATABASE_URL=postgresql://ican_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db-host:5432/ican_db
PGSSL=true
PGPOOL_MAX=10
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGINS=https://YOUR_REAL_DOMAIN.example
TRUST_PROXY=1
HTTP_PORT=8080

# Mistral AI Workforce
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Payments remain TEST mode until independently verified and approved for live use.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET_TEST=
PAYMONGO_WEBHOOK_SECRET_LIVE=
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
PAYMENT_RETURN_URL=https://YOUR_REAL_DOMAIN.example

# Optional Supabase Auth/Storage credentials. Auth and Storage are not yet wired to app flows.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ican-files
