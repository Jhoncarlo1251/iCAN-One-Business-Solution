# iCAN development environment template
# Copy this file to .env, then replace placeholders locally.
# NEVER commit the filled .env file or share it in chat/screenshots.
NODE_ENV=development
PORT=4000

# Primary database: local PostgreSQL OR Supabase PostgreSQL connection string.
# For Supabase: use the project connection string / pooler URL from Supabase Dashboard > Connect.
# URL-encode special characters in the database password. Use the pooler for hosted deployments where recommended.
DATABASE_URL=postgresql://ican_app:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/ican_db
PGSSL=false
PGPOOL_MAX=10

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4000
TRUST_PROXY=0

# Mistral AI Workforce (server-side only)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# PayMongo: TEST MODE ONLY until go-live checks are complete
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_REPLACE_ME
PAYMONGO_WEBHOOK_SECRET_TEST=whsk_REPLACE_ME
PAYMONGO_WEBHOOK_SECRET_LIVE=
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
PAYMENT_RETURN_URL=http://localhost:5500

# Optional Supabase project metadata / future Auth & Storage adapters.
# The current API can use Supabase PostgreSQL via DATABASE_URL above.
# Supabase Auth and Storage are NOT yet wired into the app's login/file workflows.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# NEVER expose this service-role key to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ican-files
