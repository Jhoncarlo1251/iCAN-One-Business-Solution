# Copy this file to .env and replace every example value.
NODE_ENV=development
PORT=4000
# Local PostgreSQL example. Use a dedicated app user, not the postgres superuser.
DATABASE_URL=postgresql://ican_app:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/ican_db
# Generate a long random secret (at least 32 bytes); never commit .env.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
# Comma-separated frontend origins. Add your real HTTPS domain before deployment.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4000


# PayMongo: begin in test mode. Never put secret keys in frontend files or source control.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_REPLACE_ME
PAYMONGO_WEBHOOK_SECRET_TEST=whsk_REPLACE_ME
# Only set live values after account approval, HTTPS deployment, and full go-live review.
PAYMONGO_WEBHOOK_SECRET_LIVE=
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
PAYMENT_RETURN_URL=http://localhost:5500
