{
  "name": "ican-one-business-solution",
  "version": "6.0.0-dev.2",
  "private": true,
  "description": "iCAN One Business Solution consolidated v6 development build with PostgreSQL API, WMS/POS and PayMongo sandbox payment foundation",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:check": "node src/db-check.js",
    "test": "node --test",
    "db:migrate:payments": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/002_payment_foundation.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "express-rate-limit": "^7.5.0"
  }
}
